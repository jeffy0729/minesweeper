<view class="container">
  <view class="title">扫雷</view>

  <view class="menu">
    <button class="menu-btn easy" bindtap="startGame" data-level="easy">
      <text class="level">简单</text>
      <text class="size">9×9 · 10雷</text>
    </button>
    <button class="menu-btn medium" bindtap="startGame" data-level="medium">
      <text class="level">中等</text>
      <text class="size">16×16 · 40雷</text>
    </button>
    <button class="menu-btn hard" bindtap="startGame" data-level="hard">
      <text class="level">困难</text>
      <text class="size">16×30 · 99雷</text>
    </button>
  </view>

  <view class="actions">
    <button class="action-btn" bindtap="goRank">排行榜</button>
  </view>
</view>