<view class="game-header">
  <view class="info-box">
    <text class="info-label">⏱️ 时间</text>
    <text class="info-value">{{time}}</text>
  </view>
  <button class="status-btn" bindtap="resetGame">{{gameOver ? (win ? '🎉' : '💥') : '🙂'}}</button>
  <view class="info-box">
    <text class="info-label">💣 剩余</text>
    <text class="info-value">{{mineCount - flagCount}}</text>
  </view>
</view>

<view class="board">
  <view class="grid" style="grid-template-columns: repeat({{cols}}, {{cellSize}}rpx);">
    <block wx:for="{{grid}}" wx:key="index">
      <view 
        class="cell {{item.opened ? 'opened' : ''}} {{item.mine && item.opened ? 'mine' : ''}} {{item.flagged ? 'flagged' : ''}} num-{{item.count}}"
        bindtap="onCellTap" 
        bindlongpress="onCellLongPress"
        data-index="{{index}}">
        <text wx:if="{{item.opened && item.mine}}">💣</text>
        <text wx:elif="{{item.opened && item.count > 0}}">{{item.count}}</text>
        <text wx:elif="{{item.flagged}}">🚩</text>
      </view>
    </block>
  </view>
</view>

<view class="modal" wx:if="{{gameOver}}">
  <view class="modal-content">
    <view class="modal-title">{{win ? '🎉 胜利!' : '💥 游戏结束'}}</view>
    <view class="modal-result" wx:if="{{win}}">用时: {{time}}秒</view>
    <view class="modal-result" wx:else>踩到雷了!</view>
    <button class="modal-btn" bindtap="resetGame">再来一局</button>
    <button class="modal-btn secondary" bindtap="backToMenu">返回主页</button>
  </view>
</view>